# Autonomous Freight — production environment template.
# Copy to `.env` on the VPS at /opt/autonomous-freight/.env and fill every required field.
# NEVER commit the actual .env — it belongs only on the server.

# ---- Public ingress ----
PUBLIC_PORT=8889
# If you wire a Cloudflare subdomain, keep PUBLIC_PORT at 8889 and point the
# CNAME/A record at 95.216.199.47 with proxying + origin rule.

# ---- Database ----
POSTGRES_USER=freight
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_VALUE
POSTGRES_DB=freight_prod

# ---- Auth ----
# Must be >= 16 chars; rotate if compromised.
JWT_ACCESS_SECRET=CHANGE_ME_32_RANDOM_CHARS_AT_LEAST
JWT_ACCESS_TTL=15m

# AES-256-GCM key-encryption-key for TOTP MFA secrets (AES-256-GCM derived via scrypt).
MFA_KEK=CHANGE_ME_32_RANDOM_CHARS_AT_LEAST

# ---- Rate limit ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Email ----
# Driver options: smtp | gmail | capture
#   smtp   = nodemailer + SMTP host (production default)
#   gmail  = Gmail OAuth (refresh-token-based, sends as the authorized account)
#   capture = in-memory; tests only
EMAIL_DRIVER=smtp

# SMTP path (used when EMAIL_DRIVER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.example

# Gmail OAuth path (used when EMAIL_DRIVER=gmail)
# Obtain via Google Cloud Console → OAuth client + offline-access refresh token.
# Send-only scope (https://www.googleapis.com/auth/gmail.send) is sufficient.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Feature flags ----
FEATURE_GA_OPTIMIZER=false

# ---- Observability (optional) ----
# Leave empty to disable OTel tracing entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info

# ---- Reserved (not yet wired in v1) ----
# STRIPE_SECRET_KEY=         # Sprint 18 — activation pending owner approval
# STRIPE_WEBHOOK_SECRET=
