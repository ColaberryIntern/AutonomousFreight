# Autonomous Freight — environment variable template
# Copy to config/development.env (gitignored) and fill in values.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker-compose maps 5433 → container 5432 to avoid conflicting with host Postgres)
DATABASE_URL=postgres://freight:freight@localhost:5434/freight_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT (Sprint 1)
JWT_ACCESS_SECRET=replace-me-32-char-min
JWT_REFRESH_SECRET=replace-me-32-char-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (Sprint 4)
# Local dev uses MailHog from docker-compose (port 1025, UI http://localhost:8025)
EMAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@autonomous-freight.local
SMTP_USER=
SMTP_PASSWORD=

# Event bus (Sprint 4: in-memory; Sprint 13: RabbitMQ)
AMQP_URL=amqp://localhost:5672

# Feature flags
FEATURE_MFA=false
FEATURE_AI_CARRIER_SELECT=false
