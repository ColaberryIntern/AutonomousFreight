{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Escalation",
  "description": "Per CLAUDE.md §Escalation Protocol. Written to /tmp/escalation.json when a strategic boundary is crossed.",
  "type": "object",
  "required": [
    "timestamp",
    "problemSummary",
    "rootCause",
    "options",
    "risks",
    "recommendation",
    "requiredDecision"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "problemSummary": { "type": "string", "minLength": 1 },
    "rootCause": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendation": { "type": "string", "minLength": 1 },
    "requiredDecision": { "type": "string", "minLength": 1 },
    "sprint": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
